NEXT_PUBLIC_APP_URL=https://impact.buffindia.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

AUTH_SECRET=replace-with-random-secret
ADMIN_EMAIL=admin@buffindia.com
ADMIN_PASSWORD=replace-with-strong-password

RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=Buffindia <noreply@buffindia.com>

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=buffindia-assets
R2_PUBLIC_URL=https://assets.buffindia.com
# ─── Production: https://impact.buffindia.com ───
# Set all variables in Vercel → Project → Settings → Environment Variables

# Public site URL (used for SEO, emails, absolute links)
NEXT_PUBLIC_APP_URL="https://impact.buffindia.com"

# Required – Neon PostgreSQL (use pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Admin panel password (cookie auth for /admin)
ADMIN_PASSWORD="your-secure-admin-password"

# Admin OTP reset email (+ Impact Calculator sales notify fallback)
ADMIN_EMAIL="admin@buffindia.com"

# Optional – Impact Calculator proposal leads (defaults to ADMIN_EMAIL)
SALES_EMAIL="sales@buffindia.com"

# Session signing secret — run: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-string"

# Resend (password reset OTP + support ticket emails)
RESEND_API_KEY=""
RESEND_FROM="Buffindia <noreply@buffindia.com>"

# Optional – Google Sheets import
GOOGLE_SHEET_ID=""
GOOGLE_API_KEY=""
