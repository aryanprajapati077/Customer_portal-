{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npx prisma generate && next build --webpack",
  "regions": ["bom1"],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.buffindia.com" }],
      "destination": "https://buffindia.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/service-renewal",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/report-sends",
      "schedule": "* * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
